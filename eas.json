{
  "cli": {
    "version": ">= 20.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "credentialsSource": "remote"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "credentialsSource": "remote"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "credentialsSource": "remote"
    }
  }
}

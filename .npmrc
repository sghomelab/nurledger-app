# npm 10 auto-installs missing (optional) peer deps during `npm install <pkg>`.
# This silently pulled react-native-reanimated@4.7.1 + react-native-worklets@0.13.1
# into the tree (they are OPTIONAL peers of expo-router / expo-modules-core).
# expo-modules-core@57.0.24 is built for worklets ^0.7–0.10, so the hoisted 0.13.1
# crashes at launch: jsi.h Value::getObject assertion in WorkletRuntime::legacyModeInit.
# legacy-peer-deps=true keeps the known-good tree (worklets/reanimated absent).
legacy-peer-deps=true

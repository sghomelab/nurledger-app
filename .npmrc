# npm 10 auto-installs missing (optional) peer deps during `npm install <pkg>`.
# This silently pulled react-native-reanimated@4.7.1 + react-native-worklets@0.13.1
# into the tree (they are OPTIONAL peers of expo-router / expo-modules-core);
# a worklets version mismatched against the native build crashed at launch
# (jsi.h Value::getObject assertion in WorkletRuntime::legacyModeInit).
# SDK 58's expo-modules-core@58.0.29 declares react-native-worklets >=0.13.0
# as an optional peer; the known-good tree keeps worklets/reanimated absent.
# legacy-peer-deps=true stops npm from auto-adding them on `npm install <pkg>`.
legacy-peer-deps=true
